#
# Server secret template for /home/clown313python/myapp/.env.
# Do not commit real DB passwords, API keys, tokens, or credential JSON files.
# Non-secret production target paths live in ops/cafe24-production-target.env.
#
FLASK_APP=
FLASK_ENV=
FLASK_RUN_PORT=
FLASK_RUN_HOST=

DB_SERVERNAME=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
RHYTHMJOY_EMAIL_DB_REQUIRED=1
RHYTHMJOY_EMAIL_STORE_RAW_BODY=1
RHYTHMJOY_EMAIL_DEDUPE_GOOGLE=0
RHYTHMJOY_NAVER_SPACECLOUD_UPLOAD_ENABLED=0
RHYTHMJOY_SPACECLOUD_EMAIL_ENABLED=0
RHYTHMJOY_SPACECLOUD_NAVER_BLOCK_ENABLED=0

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_MAIL_USERNAME=
NAVER_MAIL_PASSWORD=
NAVER_IMAP_SERVER=imap.naver.com
NAVER_IMAP_PORT=993
NAVER_SMTP_SERVER=smtp.naver.com
NAVER_SMTP_PORT=587
NAVER_SMTP_USERNAME=
NAVER_SMTP_PASSWORD=
RHYTHMJOY_EMAIL_ALERT_FROM=
RHYTHMJOY_EMAIL_ALERT_TO=
RHYTHMJOY_EMAIL_POLL_INTERVAL_SECONDS=30
RHYTHMJOY_EMAIL_SMTP_TIMEOUT_SECONDS=20
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_TIMEOUT=12

# Cafe24 SMS hosting API.
# CAFE24_SMS_USER_ID is the SMS service id, for example the id shown in Cafe24 SMS hosting.
# CAFE24_SMS_SECURE_KEY is issued in Cafe24: SMS 관리 > 소스예제 > 인증키.
# CAFE24_SMS_SENDER must be a registered sender number in Cafe24: SMS 관리 > 발신번호 관리.
CAFE24_SMS_USER_ID=
CAFE24_SMS_SECURE_KEY=
CAFE24_SMS_SENDER=
CAFE24_SMS_TIMEOUT_SECONDS=12
CAFE24_SMS_CHARSET=utf-8
CAFE24_SMS_DRY_RUN=0

SECRET_KEY=
swipeLicenseKey=

GOOGLE_API_KEY_A=
GOOGLE_API_KEY_B=
GOOGLE_API_KEY_C=
GOOGLE_API_KEY_D=
GOOGLE_API_KEY_E=
GOOGLE_SERVICE_ACCOUNT_FILE=/home/clown313python/myapp/static/rhythmjoycalendar-ce0594fe594b.json
