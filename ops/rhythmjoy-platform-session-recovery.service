[Unit]
Description=Rhythmjoy interactive Naver and SpaceCloud session recovery
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/kiosk-j/Rhythmjoy_calendar
Environment=HOME=/home/kiosk-j
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/kiosk-j/Rhythmjoy_calendar/ops/ubuntu-platform-session-recovery.sh
TimeoutStartSec=35min
TimeoutStopSec=15s
KillMode=control-group
StandardOutput=journal
StandardError=journal
